# Example environment variables for docker-compose development
# Copy this file to `.env` and replace placeholder values with your own.

# Docker Compose build settings
# Docker Compose v1 can raise a `KeyError: 'ContainerConfig'` when recreating
# services built with BuildKit. Disabling BuildKit keeps the legacy image
# metadata that docker-compose expects.
DOCKER_BUILDKIT=0
COMPOSE_DOCKER_CLI_BUILD=0

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eduSkillbridge
POSTGRES_HOST=db
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

BACKEND_PORT=5002
# DATABASE_URL and PRODUCTION_DATABASE_URL are optional. When omitted the backend
# will build a connection string from the POSTGRES_* values above.
# DATABASE_URL=postgres://postgres:change_me@db:5432/eduSkillbridge
# PRODUCTION_DATABASE_URL=postgres://postgres:change_me@db:5432/eduSkillbridge

JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
SESSION_SECRET=your_session_secret
REDIS_URL=redis://redis:6379
# Comma-separated origins Nginx should allow for CORS.
# Example: http://localhost:3000,https://example.com
ALLOWED_ORIGINS=http://localhost:3000
# Allowed frontend origin(s) for CORS. Must match the exact scheme, host,
# and port used by the frontend to avoid CORS errors. Separate multiple
# origins with commas, e.g. http://localhost:3000,https://example.com
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=example.com
# Optional domain to share cookies across subdomains
COOKIE_DOMAIN=.example.com
# Email address used for system notifications; defaults to support@APP_DOMAIN
SUPPORT_EMAIL=support@example.com
MAX_BLOG_IMAGE_BYTES=10485760
# Public base URL for the API; used for external callbacks
BACKEND_URL=http://localhost:5002
# Set to 'production' when deploying
NODE_ENV=development

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Optional display name for outgoing emails
SMTP_NAME=SkillBridge

# Book marketplace pricing defaults
# Minimum price used in book filter; defaults to 100
BOOK_PRICE_RANGE_DEFAULT=100
# Maximum price for the book price filter; defaults to 500
BOOK_PRICE_RANGE_MAX=500

# External services
# Base URL for IP geolocation lookups; defaults to https://ip-api.com
IP_API_BASE_URL=https://ip-api.com
# Secret key for Stripe payments
STRIPE_SECRET_KEY=your_stripe_secret_key
# Default ad duration in days; defaults to 0
DEFAULT_AD_DURATION_DAYS=0
# Envato API token used for license verification
ENVATO_TOKEN=your_envato_api_token_here
# Allow the demo purchase code to bypass Envato checks in local development. Ignored when NODE_ENV=production.
# LICENSE_DEMO_BYPASS=false

# OAuth provider credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
# Surround key newlines with \n
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Initial admin credentials for seed scripts (random if unset)
ADMIN_INITIAL_PASSWORD=
SUPERADMIN_INITIAL_PASSWORD=

# Directory for storing admin uploads; defaults to backend/uploads/admin
ADMIN_UPLOAD_DIR=uploads/admin
# Default locale for date parsing; uses system locale if unset
USER_LOCALE=en-US

# The frontend uses this URL for browser requests.
# Replace it with your public API endpoint before deploying.
NEXT_PUBLIC_API_BASE_URL=http://backend:5002/api
NEXT_PUBLIC_PGADMIN_URL=http://pgadmin:80

# Feature flags
ENABLE_INSTALL=false
INSTALL_API_ENABLED=false
# Set to 'true' to prevent outgoing SMS messages
DISABLE_SMS=false
# Set to 'true' to disable outbound emails
DISABLE_EMAILS=false

