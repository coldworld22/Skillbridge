# Environment variables for the backend

PORT=5002
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eduSkillbridge
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/eduSkillbridge_test
PRODUCTION_DATABASE_URL=postgres://postgres:postgres@db:5432/eduSkillbridge
JWT_SECRET=
REFRESH_TOKEN_SECRET=
MAX_BLOG_IMAGE_BYTES=10485760
CLOUDINARY_API_KEY=

# SMTP configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Price range filter defaults for books
BOOK_PRICE_RANGE_DEFAULT=100
BOOK_PRICE_RANGE_MAX=500

# Application domain and support email
APP_DOMAIN=eduskillbridge.net
SUPPORT_EMAIL=

# Allowed frontend origins separated by commas
FRONTEND_URL=https://eduskillbridge.net
COOKIE_DOMAIN=.eduskillbridge.net

# Optional overrides for cookie security
COOKIE_SECURE=false
COOKIE_SAMESITE=None

SESSION_SECRET=
# URL of Redis instance for session store
REDIS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# PayPal credentials (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ADMIN_INITIAL_PASSWORD=
# SUPERADMIN_INITIAL_PASSWORD=
