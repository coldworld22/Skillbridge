# Production frontend environment variables
# Point the frontend to your API including the /api prefix.
NEXT_PUBLIC_API_BASE_URL=https://eduskillbridge.net/api
# WebSocket server URL. Set to your API domain in production.
NEXT_PUBLIC_SOCKET_URL=https://eduskillbridge.net
# URL to pgAdmin instance for database management routes.
NEXT_PUBLIC_PGADMIN_URL=https://pgadmin.eduskillbridge.net
# Public domain where the frontend is hosted, used for image rewrites.
APP_DOMAIN=eduskillbridge.net
# Comma-separated hosts allowed for external payment icons.
NEXT_PUBLIC_TRUSTED_ICON_HOSTS=eduskillbridge.net
