# Production environment variables
#
# Copy this file to `.env.production` and update the values to match your
# deployment before running `npm run build`. Leaving these blank will cause the
# frontend to fall back to http://localhost:8000 for API requests and use the
# current origin for WebSocket connections.
APP_DOMAIN=eduskillbridge.net
NEXT_PUBLIC_API_BASE_URL=https://eduskillbridge.net/api
NEXT_PUBLIC_SOCKET_URL=wss://api.eduskillbridge.net
